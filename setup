#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
MCP_URL="${LAZYWEB_MCP_URL:-https://www.lazyweb.com/mcp}"
INSTALL_TOKEN_URL="${LAZYWEB_INSTALL_TOKEN_URL:-https://www.lazyweb.com/api/mcp/install-token}"
TOKEN_FILE="${LAZYWEB_TOKEN_FILE:-$HOME/.lazyweb/lazyweb_mcp_token}"
INSTALL_ID_FILE="${LAZYWEB_INSTALL_ID_FILE:-$HOME/.lazyweb/install_id}"
INSTALL_COOKIE_FILE="${LAZYWEB_INSTALL_COOKIE_FILE:-$HOME/.lazyweb/install_cookies}"
AUTO_UPDATE_MARKER="${LAZYWEB_AUTO_UPDATE_MARKER:-$HOME/.lazyweb/auto_update}"
HOST="auto"
QUIET=0
AUTO_UPDATE_CHOICE=""
INSTALL_ATTRIBUTION=0
INSTALL_USER_GOAL=""
INSTALL_DISCOVERY_PATH=""
INSTALL_DISCOVERY_CONTEXT=""
INSTALL_JOURNEY_ID=""

# Renamed or purged skill directories from older installs. These must never
# linger in a client skill root after setup runs, or stale slash commands stay
# visible and trapped users keep invoking server-retired skills. Used both to
# prune at install time AND to assert (verify_prune) the prune actually took.
LEGACY_SKILL_DIRS="
lazyweb-design-research
lazyweb-quick-references
lazyweb-paywall-optimization
lazyweb-signup-optimization
lazyweb-optimize-sign-up
lazyweb-optimize-paywall
lazyweb-deep-design-research
lazyweb-ab-test-research
lazyweb-design-best-practices
lazyweb-design-brainstorm
lazyweb-design-improve
lazyweb-lite-design-research
lazyweb-paywall-cta
lazyweb-growth-experiment
lazyweb-explain-flow
lazyweb-propose-ui-changes
"
# Deprecated aliases are not installed for new users, so the visible command
# set stays focused. If an upgrading user already has one, refresh it in place
# as a tiny compatibility wrapper until the alias retirement window closes.
COMPAT_ALIAS_SKILLS="lazyweb-design lazyweb-quick-search lazyweb-growth-experiments"
# The focused, user-facing slash-command set. Every other skill dir stays in the
# repo (the server/router can still reach it via lazyweb_get_workflows) but is
# intentionally NOT installed as a slash command, so anything else found in a
# client skill root is stale and must be removed.
FOCUSED_SKILLS="lazyweb-growth-score lazyweb-growth-report lazyweb-growth-backlog lazyweb-search-experiments lazyweb-search-flows lazyweb-search-screens lazyweb-apply-design-best-practices lazyweb-update"
# Skill roots older installer generations wrote to but the current installer no
# longer targets AT ALL. Nothing installs there anymore, so ANY Lazyweb dir
# found in one — including the `lazyweb` entry skill itself — is stale by
# definition and must be removed, or clients that read these roots keep
# surfacing retired skills forever.
LEGACY_SKILL_ROOTS="
$HOME/.agents/skills
"
# Skill roots install_skills_to_root touched this run, so verify_prune can
# re-check every one of them after the host loop.
INSTALLED_SKILL_ROOTS=""

usage() {
  cat <<'USAGE'
Usage: ./setup [--host auto|all|codex|claude|cursor|opencode|kiro|factory|slate|hermes|antigravity] [--quiet] [--auto-update|--no-auto-update] [--install-attribution --user-goal TEXT --discovery-path SOURCE --discovery-context TEXT [--journey-id UUID]]

Installs the standalone Lazyweb skill pack and configures direct Lazyweb MCP
access for supported local coding clients.

Flags:
  --auto-update     Opt in to silent automatic updates (creates
                    ~/.lazyweb/auto_update). Skips the interactive prompt.
  --no-auto-update  Opt out and skip the prompt; updates remain advisory.
  --install-attribution
                    Record why this acquisition installation happened.
  --user-goal TEXT  Concise summary of the original user request.
  --discovery-path SOURCE
                    user_request, web_search, reddit, shared_url, llms_txt,
                    agent_docs, webmcp, other, or unknown.
  --discovery-context TEXT
                    Observable evidence explaining how Lazyweb was discovered.
  --journey-id UUID Preserve an anonymous Lazyweb journey observed before setup.
USAGE
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --host)
      [ "${2:-}" ] || { echo "Missing value for --host" >&2; exit 1; }
      HOST="$2"
      shift 2
      ;;
    --host=*)
      HOST="${1#--host=}"
      shift
      ;;
    -q|--quiet)
      QUIET=1
      shift
      ;;
    --auto-update)
      AUTO_UPDATE_CHOICE="on"
      shift
      ;;
    --no-auto-update)
      AUTO_UPDATE_CHOICE="off"
      shift
      ;;
    --install-attribution)
      INSTALL_ATTRIBUTION=1
      shift
      ;;
    --user-goal)
      [ "${2:-}" ] || { echo "Missing value for --user-goal" >&2; exit 1; }
      INSTALL_USER_GOAL="$2"
      shift 2
      ;;
    --discovery-path)
      [ "${2:-}" ] || { echo "Missing value for --discovery-path" >&2; exit 1; }
      INSTALL_DISCOVERY_PATH="$2"
      shift 2
      ;;
    --discovery-context)
      [ "${2:-}" ] || { echo "Missing value for --discovery-context" >&2; exit 1; }
      INSTALL_DISCOVERY_CONTEXT="$2"
      shift 2
      ;;
    --journey-id)
      [ "${2:-}" ] || { echo "Missing value for --journey-id" >&2; exit 1; }
      INSTALL_JOURNEY_ID="$2"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "Unknown option: $1" >&2
      usage >&2
      exit 1
      ;;
  esac
done

if [ "$INSTALL_ATTRIBUTION" -eq 1 ]; then
  [ -n "$INSTALL_USER_GOAL" ] || { echo "--user-goal is required for installation attribution." >&2; exit 1; }
  [ -n "$INSTALL_DISCOVERY_PATH" ] || { echo "--discovery-path is required for installation attribution." >&2; exit 1; }
  case "$INSTALL_DISCOVERY_PATH" in
    user_request|web_search|reddit|shared_url|llms_txt|agent_docs|webmcp|other|unknown) ;;
    *) echo "Invalid --discovery-path: $INSTALL_DISCOVERY_PATH" >&2; exit 1 ;;
  esac
  [ -n "$INSTALL_DISCOVERY_CONTEXT" ] || { echo "--discovery-context is required for installation attribution." >&2; exit 1; }
  if [ -n "$INSTALL_JOURNEY_ID" ] && ! [[ "$INSTALL_JOURNEY_ID" =~ ^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$ ]]; then
    echo "Invalid --journey-id: expected UUID." >&2
    exit 1
  fi
fi

log() {
  [ "$QUIET" -eq 1 ] || printf '%s\n' "$*"
}

has_cmd() {
  command -v "$1" >/dev/null 2>&1
}

json_escape() {
  node -e 'process.stdout.write(JSON.stringify(process.argv[1]))' "$1"
}

link_or_copy() {
  local src="$1"
  local dst="$2"
  rm -rf "$dst"
  if ln -s "$src" "$dst" 2>/dev/null; then
    return 0
  fi
  if [ -d "$src" ]; then
    cp -R "$src" "$dst"
  else
    cp "$src" "$dst"
  fi
}

ensure_install_id() {
  local install_id=""
  mkdir -p "$(dirname "$INSTALL_ID_FILE")"
  if [ -s "$INSTALL_ID_FILE" ]; then
    install_id="$(tr -d '[:space:]' < "$INSTALL_ID_FILE")"
  fi
  if ! printf '%s' "$install_id" | node -e "let s='';process.stdin.on('data',d=>s+=d);process.stdin.on('end',()=>process.exit(/^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i.test(s)?0:1))"; then
    install_id="$(node -e "process.stdout.write(require('node:crypto').randomUUID())")"
    umask 077
    printf '%s\n' "$install_id" > "$INSTALL_ID_FILE"
  fi
  chmod 600 "$INSTALL_ID_FILE" 2>/dev/null || true
  printf '%s' "$install_id"
}

prepare_install_cookie_file() {
  mkdir -p "$(dirname "$INSTALL_COOKIE_FILE")"
  umask 077
  touch "$INSTALL_COOKIE_FILE"
  chmod 600 "$INSTALL_COOKIE_FILE" 2>/dev/null || true
}

print_install_access_error() {
  local body="$1"
  local status="$2"
  printf '%s' "$body" | node -e '
    let raw = "";
    process.stdin.on("data", (chunk) => { raw += chunk; });
    process.stdin.on("end", () => {
      const endpoint = process.argv[1];
      const status = process.argv[2];
      let payload = null;
      try { payload = JSON.parse(raw); } catch (_err) {}
      const message = payload && typeof payload.message === "string"
        ? payload.message
        : `Lazyweb MCP setup failed with HTTP ${status}.`;
      process.stderr.write(`${message}\n`);
      const upgrade = payload && (payload.upgrade_intent_url || payload.upgrade_url || payload.upgrade_base_url);
      if (typeof upgrade === "string" && upgrade) {
        try {
          process.stderr.write(`Upgrade securely: ${new URL(upgrade, endpoint).toString()}\n`);
        } catch (_err) {}
      }
    });
  ' "$INSTALL_TOKEN_URL" "$status"
}

ensure_token() {
  mkdir -p "$(dirname "$TOKEN_FILE")"

  local existing_token=""

  if [ -n "${LAZYWEB_MCP_TOKEN:-}" ]; then
    existing_token="$LAZYWEB_MCP_TOKEN"
  elif [ -s "$TOKEN_FILE" ]; then
    existing_token="$(tr -d '[:space:]' < "$TOKEN_FILE")"
  fi

  if [ "$INSTALL_ATTRIBUTION" -eq 0 ] && [ -n "$existing_token" ]; then
    printf '%s\n' "$existing_token" > "$TOKEN_FILE"
    chmod 600 "$TOKEN_FILE" 2>/dev/null || true
    printf '%s' "$existing_token"
    return 0
  fi

  [ "$QUIET" -eq 1 ] || [ -n "$existing_token" ] || printf '%s\n' "Creating a Lazyweb MCP setup credential..." >&2
  local token response body status install_id journey_id payload
  install_id="$(ensure_install_id)"
  prepare_install_cookie_file
  payload="{\"install_id\":$(json_escape "$install_id")}"
  if [ "$INSTALL_ATTRIBUTION" -eq 1 ]; then
    journey_id="${INSTALL_JOURNEY_ID:-$(node -e "process.stdout.write(require('node:crypto').randomUUID())")}"
    payload="{\"install_channel\":\"curl\",\"install_id\":$(json_escape "$install_id"),\"journey_id\":$(json_escape "$journey_id"),\"user_goal\":$(json_escape "$INSTALL_USER_GOAL"),\"discovery_path\":$(json_escape "$INSTALL_DISCOVERY_PATH"),\"discovery_context\":$(json_escape "$INSTALL_DISCOVERY_CONTEXT")}"
  fi
  # install_id rides in the JSON body — that is the server's durable-identity
  # contract (body-only, never the URL): presenting a known install_id returns
  # the ORIGINAL user/token instead of minting a fresh identity, so re-runs on
  # the same machine keep one account even if the token file was lost. The
  # X-Lazyweb-Install-Id header stays for older deployments that only log it.
  local -a curl_args=(
    -sS -X POST "$INSTALL_TOKEN_URL"
    -H "content-type: application/json"
    -H "X-Lazyweb-Install-Id: $install_id"
    -b "$INSTALL_COOKIE_FILE"
    -c "$INSTALL_COOKIE_FILE"
    -d "$payload"
    -w $'\n%{http_code}'
  )
  if [ "$INSTALL_ATTRIBUTION" -eq 1 ] && [ -n "$existing_token" ]; then
    curl_args+=( -H "Authorization: Bearer $existing_token" )
  fi
  if ! response="$(curl "${curl_args[@]}")"; then
    echo "Lazyweb MCP setup could not reach $INSTALL_TOKEN_URL. Please retry." >&2
    exit 1
  fi
  chmod 600 "$INSTALL_COOKIE_FILE" 2>/dev/null || true
  status="${response##*$'\n'}"
  body="${response%$'\n'*}"
  case "$status" in
    2??) ;;
    *)
      print_install_access_error "$body" "$status"
      exit 1
      ;;
  esac
  token="$(printf '%s' "$body" \
    | node -e "let s='';process.stdin.on('data',d=>s+=d);process.stdin.on('end',()=>{try{const j=JSON.parse(s);process.stdout.write(j.token||j.userId||'')}catch(_err){process.exitCode=1}})")"
  if [ -z "$token" ]; then
    echo "Lazyweb MCP setup returned no usable token. Please retry." >&2
    exit 1
  fi
  if [ -n "$existing_token" ] && [ "$token" != "$existing_token" ]; then
    echo "Lazyweb MCP setup returned a different identity for the existing token." >&2
    exit 1
  fi
  printf '%s\n' "$token" > "$TOKEN_FILE"
  chmod 600 "$TOKEN_FILE" 2>/dev/null || true
  printf '%s' "$token"
}

install_skills_to_root() {
  local skills_root="$1"
  mkdir -p "$skills_root"
  rm -rf "$skills_root/lazyweb"
  mkdir -p "$skills_root/lazyweb"
  # Codex's skill catalog ignores a directory whose SKILL.md entrypoint is a
  # symlink, even though it follows whole-directory symlinks for mode skills.
  # Keep the generic router as a regular file; every setup/update refreshes it.
  cp "$ROOT/skills/lazyweb/SKILL.md" "$skills_root/lazyweb/SKILL.md"
  # Remember this root so verify_prune can re-check it after the host loop.
  INSTALLED_SKILL_ROOTS="$INSTALLED_SKILL_ROOTS
$skills_root"
  # Remove renamed or purged skill directories from older installs so stale
  # slash commands do not remain visible after `lazyweb-update` runs setup.
  local legacy_skill_dir
  for legacy_skill_dir in $LEGACY_SKILL_DIRS; do
    if [ -e "$skills_root/$legacy_skill_dir" ] || [ -L "$skills_root/$legacy_skill_dir" ]; then
      # || true: never abort the install on a transient rm failure — verify_prune
      # is the safety net that re-tries and downgrades any leftover to a warning.
      rm -rf "$skills_root/$legacy_skill_dir" 2>/dev/null || true
      [ -e "$skills_root/$legacy_skill_dir" ] || log "removed stale skill: $legacy_skill_dir ($skills_root)"
    fi
  done
  # Surface only the focused, user-facing slash-command set. Every other skill
  # dir stays in the repo (the server/router can still reach it via
  # lazyweb_get_workflows — e.g. objective=create fetches lazyweb-design-create)
  # but is intentionally NOT installed as a slash command. Claude Code surfaces
  # any installed skill and has no per-skill "hide from menu" flag, so curation
  # has to happen here at install time. We iterate every dir so anything not in
  # the focused set is actively removed from the install root — no stale slash
  # commands linger (the original reason this loop avoided a hardcoded list).
  local skill_dir_path skill_dir
  for skill_dir_path in "$ROOT/skills"/*/; do
    [ -d "$skill_dir_path" ] || continue
    skill_dir="$(basename "$skill_dir_path")"
    # The generic router is installed above as a regular file so Codex catalogs
    # it. Do not let the routed-mode curation loop remove that package.
    [ "$skill_dir" = "lazyweb" ] && continue
    case " $FOCUSED_SKILLS " in
      *" $skill_dir "*)
        link_or_copy "$ROOT/skills/$skill_dir" "$skills_root/$skill_dir" ;;
      *)
        case " $COMPAT_ALIAS_SKILLS " in
          *" $skill_dir "*)
            if [ -e "$skills_root/$skill_dir" ] || [ -L "$skills_root/$skill_dir" ]; then
              link_or_copy "$ROOT/skills/$skill_dir" "$skills_root/$skill_dir"
            fi ;;
          *)
            if [ -e "$skills_root/$skill_dir" ] || [ -L "$skills_root/$skill_dir" ]; then
              rm -rf "$skills_root/$skill_dir" 2>/dev/null || true
              [ -e "$skills_root/$skill_dir" ] || log "removed stale skill: $skill_dir ($skills_root)"
            fi ;;
        esac ;;
    esac
  done
}

# After the host loop, ASSERT the prune actually took in every skill root we
# touched. The disk prune above runs per-root inside install_skills_to_root, but
# we never trust that it worked — a partial rm, a permissions hiccup, or a
# concurrently re-created dir would otherwise leave a trapped user invoking a
# server-retired skill. So re-scan, try removal again, and print a clear summary.
verify_prune() {
  local root_dir legacy_skill_dir entry name leftover=""
  for root_dir in $INSTALLED_SKILL_ROOTS; do
    [ -d "$root_dir" ] || continue
    # 1. Known renamed/purged dirs.
    for legacy_skill_dir in $LEGACY_SKILL_DIRS; do
      if [ -e "$root_dir/$legacy_skill_dir" ] || [ -L "$root_dir/$legacy_skill_dir" ]; then
        rm -rf "$root_dir/$legacy_skill_dir" 2>/dev/null || true
        if [ -e "$root_dir/$legacy_skill_dir" ] || [ -L "$root_dir/$legacy_skill_dir" ]; then
          leftover="$leftover $root_dir/$legacy_skill_dir"
        else
          log "removed stale skill: $legacy_skill_dir ($root_dir)"
        fi
      fi
    done
    # 2. Any other lazyweb-* dir that is NOT in the focused set (catches skills
    #    we have not enumerated above, e.g. a future rename).
    for entry in "$root_dir"/lazyweb-*/; do
      [ -e "$entry" ] || continue
      name="$(basename "$entry")"
      case " $FOCUSED_SKILLS " in
        *" $name "*) continue ;;
      esac
      case " $COMPAT_ALIAS_SKILLS " in
        *" $name "*) continue ;;
      esac
      rm -rf "$entry" 2>/dev/null || true
      if [ -e "$entry" ] || [ -L "$entry" ]; then
        leftover="$leftover ${entry%/}"
      else
        log "removed stale skill: $name ($root_dir)"
      fi
    done
  done
  if [ -n "$leftover" ]; then
    printf '%s\n' "WARNING: stale Lazyweb skill dirs could NOT be removed (remove manually, then restart the client):" >&2
    local item
    # A path can land in $leftover from both the legacy-list pass and the
    # lazyweb-* sweep; collapse to one line each.
    for item in $(printf '%s\n' $leftover | sort -u); do
      printf '%s\n' "  - $item" >&2
    done
    return 1
  fi
  [ -z "$INSTALLED_SKILL_ROOTS" ] || log "stale skills remaining: none"
  return 0
}

# Purge Lazyweb content from LEGACY_SKILL_ROOTS. install_skills_to_root never
# touches these roots, so its per-root prune cannot reach them — a user who
# installed with an older generation keeps stale slash commands there forever
# unless we sweep explicitly. Everything lazyweb-shaped goes, including the
# `lazyweb` entry skill: the current installer never writes here, so whatever
# exists is from a retired install.
prune_legacy_skill_roots() {
  local root_dir entry leftover=""
  for root_dir in $LEGACY_SKILL_ROOTS; do
    [ -d "$root_dir" ] || continue
    for entry in "$root_dir/lazyweb" "$root_dir"/lazyweb-*/; do
      entry="${entry%/}"
      { [ -e "$entry" ] || [ -L "$entry" ]; } || continue
      rm -rf "$entry" 2>/dev/null || true
      if [ -e "$entry" ] || [ -L "$entry" ]; then
        leftover="$leftover $entry"
      else
        log "removed stale skill: $(basename "$entry") ($root_dir)"
      fi
    done
  done
  if [ -n "$leftover" ]; then
    printf '%s\n' "WARNING: stale Lazyweb dirs in legacy skill roots could NOT be removed (remove manually, then restart the client):" >&2
    local item
    for item in $leftover; do
      printf '%s\n' "  - $item" >&2
    done
    return 1
  fi
  return 0
}

# Remove the retired Claude Code PLUGIN distribution (plugin `lazyweb@lazyweb`
# installed from the old `lazyweb` marketplace). The plugin's cached copy ships
# a frozen, pre-skill-pack skill set that Claude Code surfaces as `lazyweb:*`
# slash commands — no skill-root prune can reach it, so deregister the plugin,
# delete its cache, and drop the marketplace entry. JSON surgery goes through
# node via stdin/stdout (never node-side paths, which break under MSYS on
# Windows); file removal stays in bash. Only entries that verifiably belong to
# Lazyweb are touched, and any failure is a warning — never abort setup.
prune_claude_plugin_install() {
  local plugins_dir="$HOME/.claude/plugins"
  [ -d "$plugins_dir" ] || return 0
  local failed=""

  # 1. Deregister the plugin from installed_plugins.json.
  local installed_json="$plugins_dir/installed_plugins.json"
  if [ -f "$installed_json" ] && grep -q '"lazyweb@lazyweb"' "$installed_json" 2>/dev/null; then
    if node -e '
      let s = "";
      process.stdin.on("data", (d) => (s += d));
      process.stdin.on("end", () => {
        const j = JSON.parse(s);
        if (j && j.plugins && typeof j.plugins === "object") delete j.plugins["lazyweb@lazyweb"];
        process.stdout.write(JSON.stringify(j, null, 2));
      });' < "$installed_json" > "$installed_json.lazyweb-prune.tmp" 2>/dev/null \
      && [ -s "$installed_json.lazyweb-prune.tmp" ]; then
      mv "$installed_json.lazyweb-prune.tmp" "$installed_json"
      log "removed legacy Claude Code plugin registration: lazyweb@lazyweb"
    else
      rm -f "$installed_json.lazyweb-prune.tmp"
      failed="$failed installed_plugins.json"
    fi
  fi

  # 2. Delete the cached plugin copies (the cache dir is keyed by marketplace).
  if [ -e "$plugins_dir/cache/lazyweb" ]; then
    rm -rf "$plugins_dir/cache/lazyweb" 2>/dev/null || true
    if [ -e "$plugins_dir/cache/lazyweb" ]; then
      failed="$failed cache/lazyweb"
    else
      log "removed legacy Claude Code plugin cache: $plugins_dir/cache/lazyweb"
    fi
  fi

  # 3. Deregister the old marketplace — only when it points at lazyweb-skill,
  #    so an unrelated marketplace that happens to be named `lazyweb` survives.
  local known_json="$plugins_dir/known_marketplaces.json"
  if [ -f "$known_json" ] && grep -q '"lazyweb"' "$known_json" 2>/dev/null \
    && grep -q 'lazyweb-skill' "$known_json" 2>/dev/null; then
    # Exit code 0 = entry was ours and got deleted (JSON on stdout);
    # 3 = entry absent or not ours (leave everything alone); else = failure.
    local rc=0
    node -e '
      let s = "";
      process.stdin.on("data", (d) => (s += d));
      process.stdin.on("end", () => {
        const j = JSON.parse(s);
        const entry = j && typeof j === "object" ? j.lazyweb : null;
        if (!entry || !/lazyweb-skill/.test(JSON.stringify(entry.source || ""))) {
          process.exitCode = 3;
          return;
        }
        delete j.lazyweb;
        process.stdout.write(JSON.stringify(j, null, 2));
      });' < "$known_json" > "$known_json.lazyweb-prune.tmp" 2>/dev/null || rc=$?
    case "$rc" in
      0)
        if [ -s "$known_json.lazyweb-prune.tmp" ]; then
          mv "$known_json.lazyweb-prune.tmp" "$known_json"
          rm -rf "$plugins_dir/marketplaces/lazyweb" 2>/dev/null || true
          log "removed legacy Claude Code plugin marketplace: lazyweb"
        else
          rm -f "$known_json.lazyweb-prune.tmp"
          failed="$failed known_marketplaces.json"
        fi
        ;;
      3)
        rm -f "$known_json.lazyweb-prune.tmp"
        ;;
      *)
        rm -f "$known_json.lazyweb-prune.tmp"
        failed="$failed known_marketplaces.json"
        ;;
    esac
  fi

  if [ -n "$failed" ]; then
    printf '%s\n' "WARNING: could not fully remove the legacy Claude Code lazyweb plugin ($failed). Remove it with: claude plugin uninstall lazyweb@lazyweb" >&2
    return 1
  fi
  return 0
}

# Propagate the published pack version to a known location so the
# server-side instructions string's `cat $HOME/.lazyweb/VERSION` reads
# a real value instead of falling back to 0.0.0 (which would falsely
# look stale forever).
install_version_marker() {
  mkdir -p "$HOME/.lazyweb"
  if [ -f "$ROOT/VERSION" ]; then
    cp "$ROOT/VERSION" "$HOME/.lazyweb/VERSION"
  fi
}

# Deterministic content hash over the repo's SHIPPED canonical lazyweb-* skill
# set — the sorted, unique basenames of the `lazyweb-*` skill dirs present in
# $ROOT/skills. We hash the REPO's shipped set (not the user's whole skills dir)
# so the value is identical for every install of a given release (spec §6): the
# server can compare it against the manifest's `expected_set` for that commit and
# detect branch-trap / stale-dir installs WITHOUT trusting the per-client skill
# layout (multi-root installs, custom skill dirs, OS listing order would all
# perturb a per-client hash and cause false drift). Telemetry-only in v1.
installed_skill_set_hash() {
  local listing
  listing="$( ls -1 "$ROOT/skills" 2>/dev/null | grep '^lazyweb-' | LC_ALL=C sort -u )"
  if has_cmd shasum; then
    printf '%s\n' "$listing" | shasum -a 256 | cut -d' ' -f1
  elif has_cmd sha256sum; then
    printf '%s\n' "$listing" | sha256sum | cut -d' ' -f1
  else
    # No sha tool available — emit empty so the marker degrades gracefully
    # (server treats a missing/short set-hash as "unknown", never as drift).
    printf '%s' ""
  fi
}

# Stamp a single-line, fresh-read install fingerprint to ~/.lazyweb/INTEGRITY.
# The agent forwards this opaque string verbatim as the `integrity` arg (spec
# §3). Unlike the agent-typed `version`, a 40-hex commit SHA cannot be guessed
# or reconstructed from memory, so the server can map a KNOWN SHA -> a real
# released version and treat unknown/garbage/missing as untrusted.
#
# Format (v1): lw1.<sha40>.<version>.<setsha12>
#   - lw1       scheme/version prefix (lets the server evolve the format)
#   - <sha40>   git -C "$ROOT" rev-parse HEAD (full 40-hex) — load-bearing
#   - <version> cat $ROOT/VERSION — redundant, human-legible, degradation anchor
#   - <setsha12> first 12 hex of installed_skill_set_hash (branch-trap detector)
# For a fork/zip checkout with no .git, emit lw1.nogit.<version>.<setsha12>
# rather than fabricating a fake SHA — the server treats `nogit` as untrusted.
#
# Called right after install_version_marker. `lazyweb-update` already re-runs
# setup, so the marker refreshes on every update with no change to the updater.
install_integrity_marker() {
  mkdir -p "$HOME/.lazyweb"
  local sha ver setsha line
  sha="$(git -C "$ROOT" rev-parse HEAD 2>/dev/null || true)"
  if [ -f "$ROOT/VERSION" ]; then
    ver="$(tr -d '[:space:]' < "$ROOT/VERSION" 2>/dev/null || true)"
  fi
  [ -n "$ver" ] || ver="0.0.0"
  setsha="$(installed_skill_set_hash | cut -c1-12)"
  # Only treat it as a real git checkout if rev-parse returned a 40-hex SHA.
  case "$sha" in
    [0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f])
      line="lw1.${sha}.${ver}.${setsha}" ;;
    *)
      line="lw1.nogit.${ver}.${setsha}" ;;
  esac
  printf '%s\n' "$line" > "$HOME/.lazyweb/INTEGRITY"
}

install_lazyweb_bins() {
  mkdir -p "$HOME/.lazyweb/bin"
  # lazyweb-hosts.sh is a shared helper library and must sit beside the bins.
  for bin_name in lazyweb-context-detect lazyweb-hosts.sh lazyweb-log lazyweb-telemetry-flush lazyweb-update lazyweb-update-check; do
    [ -f "$ROOT/bin/$bin_name" ] || continue
    link_or_copy "$ROOT/bin/$bin_name" "$HOME/.lazyweb/bin/$bin_name"
    chmod +x "$HOME/.lazyweb/bin/$bin_name" 2>/dev/null || true
  done
}

write_codex_mcp_config() {
  local token="$1"
  local config_path="${CODEX_HOME:-$HOME/.codex}/config.toml"
  mkdir -p "$(dirname "$config_path")"
  CONFIG_PATH="$config_path" MCP_URL="$MCP_URL" LAZYWEB_CONFIG_TOKEN="$token" node <<'NODE'
const fs = require("fs");
const path = require("path");

const configPath = process.env.CONFIG_PATH;
const mcpUrl = process.env.MCP_URL;
const token = process.env.LAZYWEB_CONFIG_TOKEN;
const block = [
  "[mcp_servers.lazyweb]",
  `url = ${JSON.stringify(mcpUrl)}`,
  `http_headers = { Authorization = ${JSON.stringify(`Bearer ${token}`)} }`,
  ""
].join("\n");

let text = "";
try {
  text = fs.readFileSync(configPath, "utf8");
} catch (err) {
  if (err.code !== "ENOENT") throw err;
}

const lines = text.split(/\n/);
const out = [];
let skipping = false;
for (const line of lines) {
  if (/^\s*\[mcp_servers\.lazyweb\]\s*$/.test(line)) {
    skipping = true;
    continue;
  }
  if (skipping && /^\s*\[[^\]]+\]\s*$/.test(line)) {
    skipping = false;
  }
  if (!skipping) out.push(line);
}

const next = out.join("\n").trimEnd();
fs.mkdirSync(path.dirname(configPath), { recursive: true });
fs.writeFileSync(configPath, `${next}${next ? "\n\n" : ""}${block}`);
NODE
}

write_json_mcp_config() {
  local config_path="$1"
  local url_key="$2"
  local token="$3"
  mkdir -p "$(dirname "$config_path")"
  CONFIG_PATH="$config_path" MCP_URL="$MCP_URL" URL_KEY="$url_key" TOKEN="$token" node <<'NODE'
const fs = require("fs");
const path = require("path");

const configPath = process.env.CONFIG_PATH;
const urlKey = process.env.URL_KEY;
const mcpUrl = process.env.MCP_URL;
const token = process.env.TOKEN;
let data = {};
try {
  data = JSON.parse(fs.readFileSync(configPath, "utf8"));
} catch (err) {
  if (err.code !== "ENOENT") data = {};
}

if (!data || typeof data !== "object" || Array.isArray(data)) data = {};
if (!data.mcpServers || typeof data.mcpServers !== "object" || Array.isArray(data.mcpServers)) {
  data.mcpServers = {};
}
data.mcpServers.lazyweb = {
  [urlKey]: mcpUrl,
  headers: {
    Authorization: `Bearer ${token}`,
    Accept: "application/json, text/event-stream"
  },
  disabled: false
};
fs.mkdirSync(path.dirname(configPath), { recursive: true });
fs.writeFileSync(configPath, `${JSON.stringify(data, null, 2)}\n`);
NODE
}

configure_claude_mcp() {
  local token="$1"
  if ! has_cmd claude; then
    log "Claude Code CLI not found; skipping Claude MCP auto-config."
    return 0
  fi
  claude mcp remove -s user lazyweb >/dev/null 2>&1 || true
  claude mcp add --transport http --scope user lazyweb "$MCP_URL" --header "Authorization: Bearer $token" >/dev/null
}

selected_hosts() {
  case "$HOST" in
    all)
      printf '%s\n' codex claude cursor opencode kiro factory slate hermes antigravity
      ;;
    codex|claude|cursor|opencode|kiro|factory|slate|hermes|antigravity)
      printf '%s\n' "$HOST"
      ;;
    auto)
      # A client-launched install must configure that client only. Scanning all
      # binaries is still useful from a plain terminal, but is surprising and
      # potentially destructive when Codex or Claude invokes the installer on
      # a machine where several agent CLIs happen to be installed.
      case "${LAZYWEB_ACTIVE_HOST:-}" in
        codex|claude|cursor|opencode|kiro|factory|slate|hermes|antigravity)
          printf '%s\n' "$LAZYWEB_ACTIVE_HOST"
          return
          ;;
      esac
      if [ -n "${CODEX_THREAD_ID:-}${CODEX_CI:-}${CODEX_SHELL:-}" ]; then
        printf '%s\n' codex
        return
      fi
      if [ -n "${CLAUDECODE:-}${CLAUDE_CODE_ENTRYPOINT:-}" ]; then
        printf '%s\n' claude
        return
      fi
      { has_cmd codex || [ -d "$HOME/.codex" ]; } && printf '%s\n' codex
      { has_cmd claude || [ -d "$HOME/.claude" ]; } && printf '%s\n' claude
      { has_cmd cursor || [ -d "$HOME/.cursor" ]; } && printf '%s\n' cursor
      { has_cmd opencode || [ -d "$HOME/.config/opencode" ]; } && printf '%s\n' opencode
      { has_cmd kiro || [ -d "$HOME/.kiro" ]; } && printf '%s\n' kiro
      { has_cmd droid || [ -d "$HOME/.factory" ]; } && printf '%s\n' factory
      [ -d "$HOME/.slate" ] && printf '%s\n' slate
      [ -d "$HOME/.hermes" ] && printf '%s\n' hermes
      { has_cmd antigravity || has_cmd antigravity-cli || [ -d "$HOME/.gemini/antigravity" ] || [ -d "$HOME/.gemini/antigravity-cli" ] || [ -d "$HOME/.gemini/antigravity-ide" ]; } && printf '%s\n' antigravity
      ;;
    *)
      echo "Unknown --host value: $HOST" >&2
      exit 1
      ;;
  esac
}

TOKEN="$(ensure_token)"
install_lazyweb_bins
install_version_marker
install_integrity_marker

HOSTS="$(selected_hosts | awk '!seen[$0]++' || true)"
if [ -z "$HOSTS" ]; then
  printf '%s\n' "No supported local coding clients were detected."
else
  for host in $HOSTS; do
    case "$host" in
      codex)
        install_skills_to_root "${CODEX_HOME:-$HOME/.codex}/skills"
        write_codex_mcp_config "$TOKEN"
        log "Installed Lazyweb skills and MCP config for Codex."
        ;;
      claude)
        install_skills_to_root "$HOME/.claude/skills"
        configure_claude_mcp "$TOKEN"
        log "Installed Lazyweb skills and MCP config for Claude Code."
        ;;
      cursor)
        install_skills_to_root "$HOME/.cursor/skills"
        write_json_mcp_config "$HOME/.cursor/mcp.json" "url" "$TOKEN"
        log "Installed Lazyweb skills and MCP config for Cursor."
        ;;
      opencode)
        install_skills_to_root "$HOME/.config/opencode/skills"
        log "Installed Lazyweb skills for OpenCode. Add the manual MCP config below if OpenCode does not already share an MCP config."
        ;;
      kiro)
        install_skills_to_root "$HOME/.kiro/skills"
        log "Installed Lazyweb skills for Kiro. Add the manual MCP config below if Kiro does not already share an MCP config."
        ;;
      factory)
        install_skills_to_root "$HOME/.factory/skills"
        log "Installed Lazyweb skills for Factory Droid. Add the manual MCP config below if Factory does not already share an MCP config."
        ;;
      slate)
        install_skills_to_root "$HOME/.slate/skills"
        log "Installed Lazyweb skills for Slate. Add the manual MCP config below if Slate does not already share an MCP config."
        ;;
      hermes)
        install_skills_to_root "$HOME/.hermes/skills"
        log "Installed Lazyweb skills for Hermes. Add the manual MCP config below if Hermes does not already share an MCP config."
        ;;
      antigravity)
        write_json_mcp_config "$HOME/.gemini/antigravity/mcp_config.json" "serverUrl" "$TOKEN"
        write_json_mcp_config "$HOME/.gemini/antigravity-cli/mcp_config.json" "serverUrl" "$TOKEN"
        write_json_mcp_config "$HOME/.gemini/antigravity-ide/mcp_config.json" "serverUrl" "$TOKEN"
        log "Installed Lazyweb MCP config for Antigravity."
        ;;
    esac
  done

  # Assert the prune took across every skill root we touched. A leftover dir is
  # only a WARNING (printed to stderr) — it must not abort the rest of setup
  # (MCP config, router, version marker are already done above), so swallow the
  # non-zero return under `set -e`.
  verify_prune || true
fi

# Purge remnants of retired distribution channels UNCONDITIONALLY — even when
# no supported client was detected, stale files must not survive an update:
# legacy skill roots the installer no longer targets, and the old Claude Code
# plugin whose cache re-surfaces retired skills as `lazyweb:*` slash commands.
prune_legacy_skill_roots || true
prune_claude_plugin_install || true

# One-time autorouter retirement (removed in 0.15.8): strip every
# manifest-tracked LAZYWEB:ROUTER block the old consent flow wrote into
# instruction files, then drop the manifest and the stale router binary.
# Only files recorded in ~/.lazyweb/router.manifest.json are touched, and a
# BEGIN marker without END is left alone (corrupt — never guess at user files).
if [ -s "$HOME/.lazyweb/router.manifest.json" ] && command -v node >/dev/null 2>&1; then
  node - <<'RETIRE_ROUTER_EOF' || true
const fs = require("fs");
const path = require("path");
const os = require("os");
const MANIFEST = path.join(os.homedir(), ".lazyweb", "router.manifest.json");
const BEGIN = "<!-- LAZYWEB:ROUTER:BEGIN";
const ENDM = "<!-- LAZYWEB:ROUTER:END -->";
let manifest;
try { manifest = JSON.parse(fs.readFileSync(MANIFEST, "utf8")); } catch { process.exit(0); }
const failed = [];
for (const target of manifest.targets || []) {
  try {
    if (!target || !target.file || !fs.existsSync(target.file)) continue;
    const cur = fs.readFileSync(target.file, "utf8");
    const bi = cur.indexOf(BEGIN);
    if (bi === -1) continue;
    const ee = cur.indexOf(ENDM, bi);
    if (ee === -1) continue; // corrupt block: leave it alone
    // Normalize ONLY the splice seam: everything outside the markers is the
    // user's own text and keeps its exact whitespace.
    const left = cur.slice(0, bi).replace(/\n*$/, "");
    const right = cur.slice(ee + ENDM.length).replace(/^\n*/, "");
    let rest;
    if (left === "" && right === "") rest = "";
    else if (left === "") rest = right;
    else if (right === "") rest = left + "\n";
    else rest = left + "\n\n" + right;
    if (target.created_file && rest.trim() === "") {
      fs.unlinkSync(target.file);
      console.log(`Autorouter retired: removed its block and deleted ${target.file} (the router created that file)`);
    } else {
      fs.writeFileSync(target.file, rest === "" ? "" : rest.replace(/\n*$/, "") + "\n");
      console.log(`Autorouter retired: removed the LAZYWEB:ROUTER block from ${target.file}`);
    }
  } catch (err) {
    failed.push(target);
    console.error(`Autorouter retirement could not clean ${target && target.file}: ${err && err.message}. Remove the LAZYWEB:ROUTER block from it manually; it will be retried on the next update.`);
  }
}
if (failed.length) {
  try { fs.writeFileSync(MANIFEST, JSON.stringify({ targets: failed }, null, 2) + "\n"); } catch {}
} else {
  try { fs.unlinkSync(MANIFEST); } catch {}
}
RETIRE_ROUTER_EOF
fi
rm -f "$HOME/.lazyweb/bin/lazyweb-router" 2>/dev/null || true

cat <<EOF

Lazyweb setup complete.

Welcome to Lazyweb.
Hey, Ali here through your agent. I am the founder of Lazyweb. Thanks for installing our MCP.
Lazyweb gives your agent real product screenshots, product flows, and UI patterns before it designs.

Try these first:
  1. Use /lazyweb to route any Lazyweb product action through the live MCP contract.
  2. Use /lazyweb-growth-score to get, explicitly generate, or compare website scores.
  3. Use /lazyweb-growth-report for design improvement feedback on an existing screen or webpage.
  4. Use /lazyweb-apply-design-best-practices to route a UI craft task to the best specialist skill.
  5. Use /lazyweb-growth-backlog to list or add product-scoped growth specs.
  6. Use the screen, flow, and experiment search skills to collect research, then finalize it as one Agentic Search.

Token file:
  $TOKEN_FILE

Manual MCP config for any unsupported local client:
  URL: $MCP_URL
  Transport: Streamable HTTP
  Header: Authorization: Bearer <token stored in the Token file above>

First checks:
  1. Reload/restart the client.
  2. Show the Welcome to Lazyweb message above to the user.
  3. Confirm /lazyweb and the six canonical skills are visible.
  4. List MCP tools and confirm the six canonical capability tools plus lazyweb_agentic_search_finalize are present.
  5. Use the live tool schemas as the source of truth; the skills intentionally do not duplicate them.
EOF

# Auto-update opt-in. Resolved explicitly via --auto-update / --no-auto-update,
# otherwise prompted once interactively. Quiet, non-interactive, and previously
# answered installs leave the existing marker alone.
case "$AUTO_UPDATE_CHOICE" in
  on)
    mkdir -p "$(dirname "$AUTO_UPDATE_MARKER")"
    touch "$AUTO_UPDATE_MARKER"
    log "Auto-updates enabled. Disable later: rm $AUTO_UPDATE_MARKER"
    ;;
  off)
    log "Auto-updates left off. Enable later: touch $AUTO_UPDATE_MARKER"
    ;;
  *)
    if [ "$QUIET" -eq 0 ] && [ -t 0 ] && [ ! -f "$AUTO_UPDATE_MARKER" ]; then
      printf '\nEnable auto-updates so future Lazyweb skill changes apply silently? [Y/n] '
      if read -r LAZYWEB_AUTO_ANSWER; then
        case "$LAZYWEB_AUTO_ANSWER" in
          n|N|no|No|NO)
            log "Auto-updates left off. Enable later: touch $AUTO_UPDATE_MARKER"
            ;;
          *)
            mkdir -p "$(dirname "$AUTO_UPDATE_MARKER")"
            touch "$AUTO_UPDATE_MARKER"
            log "Auto-updates enabled. Disable later: rm $AUTO_UPDATE_MARKER"
            ;;
        esac
      fi
    fi
    ;;
esac
